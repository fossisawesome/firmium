{
  "name": "firmium",
  "private": true,
  "version": "4.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:app": "concurrently \"npm run dev\" \"npm run tauri:dev\"",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "release": "npm run build && npm run tauri:build",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:install": "cd android && ./gradlew installDebug"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "concurrently": "^10.0.3",
    "svelte": "^5.56.3",
    "vite": "^8.0.14"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-http": "^2.5.9"
  }
}
