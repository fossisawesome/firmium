{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "android-capability",
  "description": "Permissions for Firmium on Android",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "http://**/**" },
        { "url": "http://**:*" },
        { "url": "http://**:*/**" },
        { "url": "https://**" },
        { "url": "https://**/**" },
        { "url": "https://**:*" },
        { "url": "https://**:*/**" }
      ]
    }
  ],
  "commands": [
    "list_themes",
    "map_albums",
    "map_artists",
    "map_songs",
    "save_password",
    "get_password",
    "delete_password",
    "generate_auth_params",
    "write_log",
    "delete_logs",
    "get_log_path",
    "get_app_version",
    "get_machine_info",
    "update_now_playing",
    "update_playback_state",
    "clear_now_playing",
    "play_stream",
    "preload_stream",
    "pause_playback",
    "resume_playback",
    "stop_playback",
    "set_volume",
    "get_volume",
    "get_playback_state",
    "is_playback_finished",
    "get_track_duration",
    "get_current_position",
    "seek_position",
    "list_audio_devices",
    "crossfade_to"
  ]
}
