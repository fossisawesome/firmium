{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default-capability",
  "description": "Default permissions for the Firmium desktop application",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-decorations",
    "core:window:allow-is-decorated",
    "fs:default",
    "http:default",
    "opener:default",
    "shell:default",
    "updater:default"
  ],
  "commands": [
    "save_password",
    "get_password",
    "delete_password",
    "cache_cover",
    "get_machine_info",
    "play_stream",
    "pause_playback",
    "resume_playback",
    "stop_playback",
    "set_volume",
    "get_volume",
    "get_playback_state",
    "is_playback_finished",
    "get_track_duration",
    "get_current_position",
    "seek_position",
    "list_audio_devices"
  ]
}