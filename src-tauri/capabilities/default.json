{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default-capability",
  "description": "Default permissions for the Firmium desktop application",
  "platforms": ["linux", "windows", "macOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-decorations",
    "core:window:allow-is-decorated",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    }
  ],
  "commands": [
    "map_albums",
    "map_artists",
    "map_songs",
    "save_password",
    "get_password",
    "delete_password",
    "generate_auth_params",
    "get_app_version",
    "play_stream",
    "preload_stream",
    "pause_playback",
    "resume_playback",
    "stop_playback",
    "set_volume",
    "get_volume",
    "get_playback_state",
    "is_playback_finished",
    "get_track_duration",
    "get_current_position",
    "seek_position",
    "list_audio_devices",
    "crossfade_to",
    "set_bit_perfect_enabled",
    "list_themes"
  ]
}
