{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firmium",
  "version": "3.1.0",
  "identifier": "com.fossisawesome.firmium",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Firmium",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://tauri.localhost https://tauri.localhost; connect-src 'self' ipc: http://tauri.localhost https://tauri.localhost http://* https://*; media-src 'self' blob: http://* https://*; img-src 'self' data: blob: http://* https://*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "resources": {
      "../themes": "themes"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libasound2 | libasound2t64", "libssl3", "libsecret-1-0", "libxdo3", "libxcb1"]
      }
    },
    "windows": {
      "nsis": {}
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}