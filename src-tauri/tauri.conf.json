{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firmium",
  "version": "8.1.0",
  "identifier": "com.fossisawesome.firmium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Firmium",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**", "$CACHE/com.fossisawesome.firmium/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libasound2 | libasound2t64", "libssl3", "libsecret-1-0", "libxdo3", "libxcb1"]
      }
    }
  }
}
