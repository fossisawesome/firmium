{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firmium",
  "version": "6.1.6",
  "identifier": "com.fossisawesome.firmium",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Firmium",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://tauri.localhost https://tauri.localhost; connect-src 'self' ipc: http://tauri.localhost https://tauri.localhost http://* https://*; media-src 'self' blob: http://* https://*; img-src 'self' data: blob: asset: http://asset.localhost http://* https://*;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/covers/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "nsis"],
    "resources": {
      "../themes": "themes"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libasound2 | libasound2t64", "libssl3", "libsecret-1-0", "libxdo3", "libxcb1"]
      }
    },
    "windows": {
      "nsis": {}
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGNjIxODNCQUNENDg3Q0QKUldUTmg5U3NPeGhpajN1ZG5FNWdVbkhFaHRiQ05iQmYrOEFXd1YyR2NLaFpLVGJVL0NzcUEwcysK",
      "endpoints": [
        "https://github.com/fossisawesome/firmium/releases/latest/download/latest.json"
      ]
    }
  }
}