{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firmium",
  "version": "2.0.4",
  "identifier": "com.fossisawesome.firmium",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Firmium",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://tauri.localhost https://tauri.localhost; connect-src 'self' ipc: http://tauri.localhost https://tauri.localhost http://* https://*; media-src 'self' blob: http://* https://*; img-src 'self' data: blob: http://* https://*;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fossisawesome/firmium/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMDFDMzdDRkVFQTI5M0EKUldRNktlcitmTU1Cck93bUlWcWxQQUY0TlA0ZUZLbXRwc2lNTElJallGQTExb0JZNDVLdzg3Sm8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libasound2 | libasound2t64", "libssl3"]
      }
    },
    "windows": {
      "nsis": {}
    }
  }
}